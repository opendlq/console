{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm",
    "analytics": false
  },
  "newProjectRoot": "",
  "projects": {
    "console": {
      "projectType": "application",
      "schematics": {},
      "root": "apps/console",
      "sourceRoot": "apps/console/src",
      "prefix": "odlq",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "apps/console/src/main.ts",
            "tsConfig": "apps/console/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/console/public"
              }
            ],
            "styles": [
              "node_modules/@fontsource-variable/inter/index.css",
              "node_modules/@fontsource-variable/jetbrains-mono/index.css",
              "node_modules/@angular/cdk/overlay-prebuilt.css",
              "packages/ui/src/styles/index.css",
              "apps/console/src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "600kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "16kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "console:build:production"
            },
            "development": {
              "buildTarget": "console:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "polyfills": []
          }
        }
      }
    },
    "ui": {
      "projectType": "library",
      "root": "packages/ui",
      "sourceRoot": "packages/ui/src",
      "prefix": "odlq",
      "architect": {
        "build": {
          "builder": "@angular/build:library",
          "options": {
            "tsConfig": "packages/ui/tsconfig.lib.json"
          },
          "configurations": {
            "production": {},
            "development": {
              "compilationMode": "full",
              "declarationMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "packages/ui/tsconfig.spec.json",
            "polyfills": []
          }
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "configDir": "packages/ui/.storybook",
            "browserTarget": "ui:build",
            "tsConfig": "packages/ui/.storybook/tsconfig.json",
            "styles": [
              "node_modules/@fontsource-variable/inter/index.css",
              "node_modules/@fontsource-variable/jetbrains-mono/index.css",
              "node_modules/@angular/cdk/overlay-prebuilt.css",
              "packages/ui/src/styles/index.css"
            ],
            "compodoc": true,
            "compodocArgs": [
              "-e",
              "json",
              "-d",
              "packages/ui"
            ],
            "experimentalZoneless": true,
            "port": 6006
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "configDir": "packages/ui/.storybook",
            "browserTarget": "ui:build",
            "tsConfig": "packages/ui/.storybook/tsconfig.json",
            "styles": [
              "node_modules/@fontsource-variable/inter/index.css",
              "node_modules/@fontsource-variable/jetbrains-mono/index.css",
              "node_modules/@angular/cdk/overlay-prebuilt.css",
              "packages/ui/src/styles/index.css"
            ],
            "compodoc": true,
            "compodocArgs": [
              "-e",
              "json",
              "-d",
              "packages/ui"
            ],
            "experimentalZoneless": true,
            "outputDir": "dist/storybook"
          }
        }
      }
    },
    "modules": {
      "projectType": "library",
      "root": "packages/modules",
      "sourceRoot": "packages/modules/src",
      "prefix": "odlq",
      "architect": {
        "build": {
          "builder": "@angular/build:library",
          "options": {
            "tsConfig": "packages/modules/tsconfig.lib.json"
          },
          "configurations": {
            "production": {},
            "development": {
              "compilationMode": "full",
              "declarationMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "packages/modules/tsconfig.spec.json",
            "polyfills": []
          }
        }
      }
    }
  }
}
